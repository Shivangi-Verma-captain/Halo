{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "cd ../shared && npm run build && cd ../client && npm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "buildCommand": "cd ../shared && npm run build && cd ../server && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
