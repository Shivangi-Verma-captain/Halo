# Server
PORT=3001
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins allowed for Socket.IO CORS (production)
# e.g. ADDITIONAL_ORIGINS=https://your-frontend.pages.dev,https://example.com
ADDITIONAL_ORIGINS=
# Optional fixed round seed for debugging (integer string). Leave empty for random.
# FIXED_SEED=42

# Client (Vite — must be prefixed with VITE_ to reach the browser)
# Copy these into client/.env.local for local dev if the server port differs:
# VITE_SERVER_URL=http://localhost:3001
